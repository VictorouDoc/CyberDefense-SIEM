[Unit]
Description=[ORGANIZATION] SIEM - Security Information and Event Management
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/admin/siem
ExecStart=/home/admin/siem_env/bin/python run.py --capture --interface eth0 --port 8080
ExecStop=/bin/kill -TERM $MAINPID
Restart=always
RestartSec=10
StandardOutput=append:/tmp/siem.log
StandardError=append:/tmp/siem.log

# Environment
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
